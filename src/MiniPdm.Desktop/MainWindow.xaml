<Window x:Class="MiniPdm.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiniPdm.Desktop.ViewModels"
        xmlns:services="clr-namespace:MiniPdm.Desktop.Services"
        Title="MiniPDM — Состав изделия"
        Width="1180"
        Height="820"
        MinWidth="950"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <services:PdmEnumToRussianConverter
            x:Key="PdmEnumToRussianConverter"/>

        <HierarchicalDataTemplate DataType="{x:Type vm:BomTreeItemViewModel}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayText}"/>
        </HierarchicalDataTemplate>

    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="145"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="34"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <Button Grid.Column="2"
                    Height="34"
                    Content="Найти"
                    Command="{Binding SearchCommand}"/>

            <Button Grid.Column="4"
                    Height="34"
                    Content="Обновить"
                    Command="{Binding RefreshCommand}"/>

            <Button Grid.Column="6"
                    Height="34"
                    Content="Импортировать папку"
                    Command="{Binding ImportFolderCommand}"/>

        </Grid>

        <!-- Основная область -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Список объектов -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Objects}"
                      SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Тип"
                                        Width="140"
                                        Binding="{Binding ObjectType,
                                            Converter={StaticResource PdmEnumToRussianConverter}}"/>

                    <DataGridTextColumn Header="Обозначение"
                                        Width="180"
                                        Binding="{Binding Designation}"/>

                    <DataGridTextColumn Header="Наименование"
                                        Width="*"
                                        Binding="{Binding Name}"/>

                    <DataGridTextColumn Header="Версия"
                                        Width="70"
                                        Binding="{Binding CurrentVersionNumber}"/>

                    <DataGridTextColumn Header="Состояние"
                                        Width="110"
                                        Binding="{Binding CurrentState,
                                            Converter={StaticResource PdmEnumToRussianConverter}}"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- Правая область -->
            <Border Grid.Column="2"
                    Padding="8"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1">

                <TabControl>

                    <!-- Карточка -->
                    <TabItem Header="Карточка">

                        <Grid Margin="8">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Карточка объекта"/>

                            <StackPanel Grid.Row="2">

                                <TextBlock FontWeight="SemiBold"
                                           Text="Наименование"/>

                                <TextBlock Margin="0,1,0,6"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedDetails.Name}"/>

                                <TextBlock FontWeight="SemiBold"
                                           Text="Тип"/>

                                <TextBlock Margin="0,1,0,6"
                                           Text="{Binding SelectedDetails.ObjectType,
                                            Converter={StaticResource PdmEnumToRussianConverter}}"/>

                                <TextBlock FontWeight="SemiBold"
                                           Text="Обозначение"/>

                                <TextBlock Margin="0,1,0,6"
                                           Text="{Binding SelectedDetails.Designation}"/>

                                <TextBlock FontWeight="SemiBold"
                                           Text="Текущая версия"/>

                                <TextBlock Margin="0,1,0,6"
                                           Text="{Binding SelectedDetails.CurrentVersion.VersionNumber}"/>

                                <TextBlock FontWeight="SemiBold"
                                           Text="Состояние"/>

                                <TextBlock Margin="0,1,0,6"
                                           Text="{Binding SelectedDetails.CurrentVersion.State,
                                            Converter={StaticResource PdmEnumToRussianConverter}}"/>

                                <TextBlock FontWeight="SemiBold"
                                           Text="Материал"/>

                                <TextBlock Margin="0,1,0,6"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedDetails.CurrentVersion.Material}"/>

                                <TextBlock FontWeight="SemiBold"
                                           Text="Масса, кг"/>

                                <TextBlock Text="{Binding SelectedDetails.CurrentVersion.MassKg}"/>

                            </StackPanel>

                            <Grid Grid.Row="4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Height="32"
                                        Content="Утвердить"
                                        Command="{Binding ApproveCommand}"/>

                                <Button Grid.Column="2"
                                        Height="32"
                                        Content="Аннулировать версию"
                                        Command="{Binding CancelCommand}"/>

                            </Grid>

                            <TextBlock Grid.Row="6"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="История версий"/>

                            <DataGrid Grid.Row="8"
                                      MinHeight="90"
                                      ItemsSource="{Binding SelectedDetails.Versions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeight="24"
                                      ColumnHeaderHeight="26">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="№"
                                                        Width="45"
                                                        Binding="{Binding VersionNumber}"/>

                                    <DataGridTextColumn Header="Состояние"
                                                        Width="110"
                                                        Binding="{Binding State,
                                                            Converter={StaticResource PdmEnumToRussianConverter}}"/>

                                    <DataGridTextColumn Header="Материал"
                                                        Width="*"
                                                        Binding="{Binding Material}"/>

                                    <DataGridTextColumn Header="Масса"
                                                        Width="80"
                                                        Binding="{Binding MassKg}"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </TabItem>

                    <!-- Состав -->
                    <TabItem Header="Состав">

                        <Grid Margin="8">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal">

                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Расчётная масса: "/>

                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding CalculatedMassKg}"/>

                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text=" кг"/>

                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding CalculationIssues}"
                                       TextWrapping="Wrap"
                                       Foreground="DarkRed"/>

                            <TreeView Grid.Row="4"
                                      ItemsSource="{Binding BomTreeItems}"/>

                        </Grid>

                    </TabItem>

                    <!-- Спецификация -->
                    <TabItem Header="Спецификация">

                        <Grid Margin="8">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding CalculationIssues}"
                                       TextWrapping="Wrap"
                                       Foreground="DarkRed"/>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding SpecificationItems}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeight="25"
                                      ColumnHeaderHeight="28">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Обозначение"
                                                        Width="125"
                                                        Binding="{Binding Designation}"/>

                                    <DataGridTextColumn Header="Наименование"
                                                        Width="*"
                                                        MinWidth="120"
                                                        Binding="{Binding Name}"/>

                                    <DataGridTextColumn Header="Материал"
                                                        Width="85"
                                                        Binding="{Binding Material}"/>

                                    <DataGridTextColumn Header="Масса"
                                                        Width="65"
                                                        Binding="{Binding MassKg}"/>

                                    <DataGridTextColumn Header="Кол-во"
                                                        Width="55"
                                                        Binding="{Binding Quantity}"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </TabItem>

                </TabControl>

            </Border>

        </Grid>

        <!-- Отчёт импорта -->
        <GroupBox Grid.Row="4"
                  Header="Отчёт импорта"
                  Padding="8">

            <DataGrid ItemsSource="{Binding ImportReportItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Файл"
                                        Width="280"
                                        Binding="{Binding FileName}"/>

                    <DataGridTextColumn Header="Статус"
                                        Width="100"
                                        Binding="{Binding Status}"/>

                    <DataGridTextColumn Header="Сообщение"
                                        Width="*"
                                        Binding="{Binding Message}"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- Строка состояния -->
        <Border Grid.Row="6"
                Padding="8"
                BorderBrush="#D0D0D0"
                BorderThickness="1">

            <TextBlock Text="{Binding StatusMessage}"/>

        </Border>

    </Grid>

</Window>